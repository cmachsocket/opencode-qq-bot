# NapCat 正向 WebSocket 地址（必填）
NAPCAT_WS_URL=ws://127.0.0.1:3001
# NapCat 访问令牌（可选）
NAPCAT_WS_TOKEN=

# 放行的群号，逗号分隔；留空时看 QQ_ALLOW_ALL_WHEN_EMPTY
QQ_ALLOW_GROUPS=
# 放行的私聊 QQ 号，逗号分隔；留空时看 QQ_ALLOW_ALL_WHEN_EMPTY
QQ_ALLOW_USERS=
# 拒绝的群号，逗号分隔；优先于放行名单
QQ_DENY_GROUPS=
# 拒绝的私聊 QQ 号，逗号分隔；优先于放行名单
QQ_DENY_USERS=
# 放行名单为空时是否放行全部目标（布尔）
QQ_ALLOW_ALL_WHEN_EMPTY=
# 机器人所有者 QQ 号：管理命令只在它的私聊里生效，该私聊始终放行
# QQ_OWNER_QQ=
# 管理员 QQ 号，逗号分隔：拥有全部工具权限
# QQ_ADMINS=
# 工具配置文件路径，默认当前工作目录下的 tool-profiles.json
# QQ_TOOL_PROFILES=
# 会话行为覆盖文件路径，默认当前工作目录下的 chat-overrides.json
# QQ_CHAT_OVERRIDES=

# 角色设定文件路径，默认使用 souls/default.txt
# QQ_BOT_SOUL_PATH=
# souls 目录里的角色设定文件名，默认 default.txt
# QQ_BOT_SOUL_NAME=default.txt

# 机器人会话的工作目录，必须是绝对路径或 ~/ 开头
# 默认 $XDG_DATA_HOME/opencode-qq-bot/workspace
# QQ_BOT_HOME=

# 会话使用的 agent / 模型（provider/model[/variant]）
# QQ_BOT_AGENT=
# QQ_BOT_MODEL=

# 拆行发送间隔（毫秒）
# QQ_SEND_DELAY_MS=1000
# 单次发送的内容超过该长度时告警
# QQ_WARN_LENGTH=500
# 分段回复：段与段之间的随机等待区间（毫秒），0 表示沿用 QQ_SEND_DELAY_MS
# QQ_REPLY_MIN_DELAY_MS=0
# QQ_REPLY_MAX_DELAY_MS=0
# 单条消息最多多少字，超过就拆成多段发
# QQ_REPLY_SEGMENT_CHARS=150
# 超过该字数的回复改用合并转发发出，0 表示不转换
# QQ_REPLY_FORWARD_THRESHOLD_CHARS=1500
# 唤醒判定：全局唤醒前缀，逗号分隔；留空表示只用被 @
# QQ_WAKE_PREFIXES=/
# @全体成员是否忽略（布尔）
# QQ_WAKE_IGNORE_AT_ALL=true
# 回复机器人自己的消息是否必回（布尔）
# QQ_WAKE_REPLY_TO_SELF=true
# 群里第一个 @ 的是别人时是否不唤醒机器人（布尔）
# QQ_WAKE_IGNORE_AT_OTHERS=true
# 重启后复用上一次的会话（布尔：true/false、1/0、yes/no、on/off）
# QQ_REUSE_SESSION=false

# 主动说话心跳
# QQ_PROACTIVE_ENABLED=true
# QQ_PROACTIVE_SILENCE_SECONDS=10800
# QQ_PROACTIVE_P_START=0.01
# QQ_PROACTIVE_P_SLOPE_PER_HOUR=0.05
# QQ_PROACTIVE_TICK_SECONDS=3600
# 允许主动说话的群号，逗号分隔；留空表示都不主动说话
# QQ_PROACTIVE_ALLOW_GROUPS=
# 允许主动说话的私聊 QQ 号，逗号分隔；留空表示都不主动说话
# QQ_PROACTIVE_ALLOW_USERS=

# 模型一轮没调用发送工具时的提醒
# QQ_REMINDER_ENABLED=true
# QQ_REMINDER_MAX=2

# 保活心跳：避免 OpenCode 长时间没有会话活动时卸载插件
# QQ_KEEP_ALIVE_ENABLED=true
# QQ_KEEP_ALIVE_SECONDS=1200

# 新建或恢复会话时补多少条历史消息，0 表示关闭
# QQ_HISTORY_COUNT=20

# 出站限流：每分钟 / 每小时最多发多少条，0 表示不限制
# QQ_RATE_MAX_PER_MINUTE=8
# QQ_RATE_MAX_PER_HOUR=60
# 相邻两次发送之间的最小间隔（毫秒），0 表示不限制
# QQ_RATE_MIN_GAP_MS=1500
# 每分钟额度用完时是否等窗口结束再发（布尔）；每小时上限始终直接拒绝
# QQ_RATE_STALL=false
# 等待窗口结束最多等多久（毫秒），超过就直接拒绝
# QQ_RATE_STALL_MAX_WAIT_MS=60000

# 出站敏感信息拦截：含凭证、令牌、私钥的消息整条不发送
# QQ_SENSITIVE_ENABLED=true

# 订阅的事件类别，逗号分隔：message（消息）、notice（通知）；默认只订阅消息
# QQ_EVENT_SUBSCRIBE=message
# 通知类里关心哪些通知，逗号分隔：group_recall、notify.poke 等；留空表示全收
# QQ_EVENT_NOTICES=
# 通知是否注入会话上下文（布尔）
# QQ_EVENT_INJECT=true

# 日志级别：debug / info / warn / error
# QQ_LOG_LEVEL=info
# 日志文件目录，默认 $XDG_STATE_HOME/opencode-qq-bot/logs
# QQ_LOG_DIR=
# 单个日志文件的大小上限
# QQ_LOG_MAX_SIZE=5m
# 保留多少个历史日志文件
# QQ_LOG_MAX_FILES=5

# 调用链追踪：一条入站消息一个 trace_id，事后能把这轮串起来
# QQ_TRACE_ENABLED=true
# 追踪文件目录，默认与日志同目录
# QQ_TRACE_DIR=
# 追踪文件总容量上限（MB）
# QQ_TRACE_MAX_SIZE_MB=80
# 追踪文件保留天数
# QQ_TRACE_RETENTION_DAYS=7

# 额外允许发送图片、语音的目录，逗号分隔
# 默认只允许机器人工作目录与媒体目录
# QQ_MEDIA_ALLOWED_DIRS=
