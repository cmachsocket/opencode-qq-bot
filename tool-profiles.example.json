{
  "defaultProfile": "chat",
  "profiles": {
    "chat": {
      "allow": ["websearch", "webfetch", "qq_*"],
      "deny": ["qq_diary_*", "qq_send_file"]
    },
    "readonly": {
      "allow": ["read", "glob", "grep", "qq_*"],
      "deny": ["qq_diary_*", "qq_send_file"]
    },
    "proactive": {
      "allow": ["websearch", "webfetch", "qq_*"],
      "deny": ["qq_diary_*", "qq_send_file"]
    },
    "admin": {
      "allow": ["*"],
      "deny": []
    }
  },
  "chats": {
    "group:100": "readonly",
    "private:200": "chat"
  }
}
