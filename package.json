{
  "name": "@cmach_socket/opencode-qq-bot",
  "version": "0.9.2",
  "description": "OpenCode V2 plugin bridging a QQ group chat (NapCat via NapLink) to an OpenCode session.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cmachsocket/opencode-qq-bot.git"
  },
  "homepage": "https://github.com/cmachsocket/opencode-qq-bot#readme",
  "bugs": {
    "url": "https://github.com/cmachsocket/opencode-qq-bot/issues"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "souls",
    "web/dist",
    "config.example.json",
    "tool-profiles.example.json",
    "chat-overrides.example.json",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tests/web/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "web:build": "bun run --cwd web build",
    "web:dev": "bun run --cwd web dev",
    "web:check": "bun run --cwd web check",
    "ci": "bun run typecheck && bun run lint && bun run test && bun run format:check",
    "privacy:scan": "trufflehog git file://. --config=scripts/trufflehog.yml --include-detectors=CustomRegex --no-verification --no-update --fail",
    "release:check": "bun scripts/release-check.ts"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "napcat",
    "naplink",
    "onebot",
    "qq"
  ],
  "license": "CC-BY-NC-SA-4.0",
  "dependencies": {
    "@bybrave/proper-lockfile2": "5.1.0",
    "@hono/node-server": "2.1.7",
    "@naplink/naplink": "1.2.0",
    "@opencode/plugin": "2.2.5",
    "@opencode/schema": "2.2.5",
    "async-mutex": "0.5.0",
    "chokidar": "6.0.0",
    "flare-redact": "1.6.1",
    "hono": "4.13.18",
    "ipaddr.js": "2.5.0",
    "remove-markdown": "0.8.0",
    "request-filtering-agent": "3.2.1",
    "winston": "3.19.0",
    "winston-daily-rotate-file": "5.0.0",
    "write-file-atomic": "8.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/svelte": "5.2.8",
    "@types/bun": "1.4.4",
    "@types/write-file-atomic": "4.0.3",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "jsdom": "^31.0.0",
    "prettier": "3.9.10",
    "svelte": "5.57.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
