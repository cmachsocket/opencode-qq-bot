{
  "name": "@cmach_socket/opencode-qq-bot",
  "version": "0.4.0",
  "description": "OpenCode V2 plugin bridging a QQ group chat (NapCat via NapLink) to an OpenCode session.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "souls",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "napcat",
    "naplink",
    "onebot",
    "qq"
  ],
  "license": "CC-BY-NC-SA-4.0",
  "dependencies": {
    "@bybrave/proper-lockfile2": "5.1.0",
    "@naplink/naplink": "1.2.0",
    "@opencode/plugin": "2.2.5",
    "@opencode/schema": "2.2.5",
    "async-mutex": "^0.5.0",
    "flare-redact": "1.6.1",
    "remove-markdown": "0.8.0",
    "request-filtering-agent": "3.2.1",
    "winston": "3.19.0",
    "winston-daily-rotate-file": "5.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
